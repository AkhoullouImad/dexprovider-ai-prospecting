    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nlet Score = 0;\n\n// 1. Recrutement en cours (30 pts)\nconst recrutement = (data[\"Recrutement en cours\"] || \"\").toLowerCase();\nif (recrutement === \"oui\") Score += 30;\n\n// 2. Secteur cible (25 pts) — exact list from sheet formula\nconst targetSectors = [\n  \"BTP\",\n  \"Transport\",\n  \"Logistique\",\n  \"Santé\",\n  \"Restauration\",\n  \"Nettoyage\",\n  \"Cabinet comptable\",\n  \"immobilier\",\n  \"Immobilier\",\n  \"Service à domicile\",\n  \"Services à domicile\"\n];\nconst secteur = data[\"Secteur\"] || \"\";\nif (targetSectors.includes(secteur)) {\n  Score += 25;\n} else if (secteur === \"Autre\") {\n  Score += 10;\n}\n\n// 3. Effectif (20/15/10 pts)\nconst effectif = data[\"Effectif\"] || \"\";\nif (effectif === \"51-200\") Score += 20;\nelse if (effectif === \"11-50\") Score += 15;\nelse if (effectif === \"201-500\") Score += 10;\n\n// 4. Décideur identifié (15 pts)\nconst decideur = (data[\"Décideur identifié\"] || \"\").toLowerCase();\nif (decideur === \"oui\") Score += 15;\n\n// 5. Activité LinkedIn (10 pts)\nconst linkedin = (data[\"Activité LinkedIn\"] || \"\").toLowerCase();\nif (linkedin === \"oui\") Score += 10;\n\n// Priority\nlet Priorité = \"⚪ Faible\";\nif (Score >= 80) Priorité = \"🔥 Haute\";\nelse if (Score >= 50) Priorité = \"🟡 Moyenne\";\n\n// Correspondance ICP\nlet correspondanceICP = \"faible\";\nif (Score >= 80) correspondanceICP = \"élevée\";\nelse if (Score >= 50) correspondanceICP = \"moyen\";\n\nreturn [{\n  json: {\n    ...data,\n    Score,\n    Priorité,\n    correspondanceICP\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        544
      ],
      "id": "c3d3242b-54f5-4c8d-be61-bae36b3bbd37",
      "name": "Calculate Score1"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tu es un consultant commercial senior spécialisé en externalisation RH pour Dexprovider.\n\nMission :\nAnalyser un prospect et rédiger une note CRM permettant à un commercial de comprendre rapidement :\n* pourquoi l'entreprise est intéressante ou non,\n* quels besoins RH sont les plus probables,\n* quels éléments justifient une prise de contact.\n\nRègles strictes :\n* Utilise uniquement les informations fournies.\n* N'invente aucun fait.\n* Ne suppose pas l'existence de difficultés internes.\n* Ne répète pas simplement les données du prospect.\n* Explique les conséquences des signaux observés.\n* Adopte un raisonnement commercial B2B.\n* Écris comme un consultant RH expérimenté.\n* Maximum 5 phrases pour la note.\n* Français professionnel.\n\nDonnées du prospect :\nEntreprise : {{ $json[\"Nom de l'Entreprise\"] }}\nSecteur : {{ $json[\"Secteur\"] }}\nEffectif : {{ $json[\"Effectif\"] }}\nRecrutement en cours : {{ $json[\"Recrutement en cours\"] }}\nOffres ouvertes : {{ $json[\"Nb offres actives\"] }}\nCroissance visible : {{ $json[\"Croissance visible\"] }}\nActivité LinkedIn : {{ $json[\"Activité LinkedIn\"] }}\nDécideur identifié : {{ $json[\"Décideur identifié\"] }}\nContact : {{ $json[\"Nom du contact\"] }}\nRôle du contact : {{ $json[\"Fonction\"] }}\nVille : {{ $json[\"Ville\"] }}\nScore interne : {{ $json.Score }}\nPriorité : {{ $json.Priorité }}\n\nRéponds UNIQUEMENT avec un JSON valide.\nLa réponse doit commencer par { et se terminer par }.\nAucun texte avant ou après le JSON.\n\nFormat obligatoire :\n{\n  \"qualification\": \"oui\" ou \"non\",\n  \"qualification_reason\": \"maximum 10 mots, uniquement les signaux, pas d'interprétation\",\n  \"summary\": \"résumé en une phrase\",\n  \"hr_needs\": [\n    \"besoin RH 1\",\n    \"besoin RH 2\"\n  ],\n  \"note\": \"note CRM en 5 phrases maximum\"\n}\n\nInstructions pour le champ 'note' :\n1. Identifier les signaux observables.\n2. Expliquer ce qu'ils indiquent en matière de gestion RH.\n3. Expliquer pourquoi Dexprovider pourrait être pertinent.\n4. Se terminer par une conclusion commerciale claire.\n\nNe jamais écrire :\n* \"le score est élevé\" ou \"le score est faible\"\n* \"selon les critères\"\n* \"cette entreprise compte X salariés\"\n\nLa note doit apporter une analyse, pas une description.",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
