    {
      "parameters": {
        "jsCode": "const originalData = $('Calculate Score1').first().json;\n\nlet aiResponse = $input.first().json.text;\n\nconst match = aiResponse.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error(\"No JSON found in AI response\");\n\nconst parsed = JSON.parse(match[0]);\n\n// Scoring engine owns these — never let LLM overwrite them\ndelete parsed.priority;\ndelete parsed.Priorité;\ndelete parsed.Score;\ndelete parsed.score;\n\nreturn [{\n  json: {\n    ...originalData,\n    ...parsed\n  }\n}];"
      },
